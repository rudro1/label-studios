# ---- Fixensy / Fixstudio VPS .env ----
# Copy: cp .env.example .env  then edit values.

# Bind address. 0.0.0.0 for public VPS (behind reverse proxy). 127.0.0.1 for local only.
APP_BIND_HOST=0.0.0.0
APP_PORT=8080

# Docker frontend build: Node heap MB for `yarn run build` (lower if you see "cannot allocate memory")
NODE_MEMORY_MB=2048

# Postgres (used by both db and label_studio services)
# The DB container only applies POSTGRES_PASSWORD on first volume init; if you change this later,
# either match the original password or use a fresh volume (new COMPOSE_PROJECT_NAME, or docker compose down -v).
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=labelstudio

# Initial superuser (created on first boot if DB empty)
LABEL_STUDIO_USERNAME=admin@example.com
LABEL_STUDIO_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Public hostname that serves the app (also passed to Django as HOST). Local example:
# LABEL_STUDIO_HOST=http://127.0.0.1:8080
LABEL_STUDIO_HOST=

# Set true when TLS terminates at nginx/Caddy in front of this container
LABEL_STUDIO_BEHIND_PROXY=false

# Comma-separated origins trusted for CSRF (e.g. https://label.example.com)
CSRF_TRUSTED_ORIGINS=

# Django secret. Generate with: python -c 'import secrets;print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING

# Fixensy Super Admin (min 12 chars). Used by: python manage.py create_super_admin
FIXENSY_SUPERADMIN_EMAIL=superadmin@fixensy.com
FIXENSY_SUPERADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARS

# scripts/fixensy_docker_bootstrap.sh wait loop (optional; see FIXENSY_PLAN.md)
# BOOTSTRAP_WAIT_ATTEMPTS=180
# BOOTSTRAP_WAIT_SLEEP_SEC=2

# ---- Free local AI transcription (no paid API needed) ----
# Engine options: auto | faster_whisper | whisper | openai
FIXENSY_ASR_ENGINE=faster_whisper
# Model options (accuracy vs speed): tiny | base | small | medium | large-v3
FIXENSY_ASR_MODEL=small
# translate => output English, transcribe => keep source language
FIXENSY_ASR_TASK=transcribe
# Optional target language marker in response payload
FIXENSY_ASR_TARGET_LANGUAGE=en
