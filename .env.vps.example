# =====================================================
# Label Studio — VPS / Production environment template
# Copy to .env and fill in your values.
# Compose: docker-compose.vps.yml
# =====================================================

# ----- Docker image -----
IMAGE=ghcr.io/rudro1/label-studios:latest

# ----- Hosting -----
# HTTP for plain IP, HTTPS if you have a domain + SSL cert
LABEL_STUDIO_HOST=http://35.240.222.149

# ----- Admin (created/reset on every deploy) -----
LABEL_STUDIO_USERNAME=info@fixensy.com
LABEL_STUDIO_PASSWORD=Fixensy01+

# ----- PostgreSQL -----
POSTGRES_DB=labelstudio
POSTGRES_USER=labelstudio
POSTGRES_PASSWORD=securepassword123

# ----- uWSGI tuning -----
UWSGI_PROCESSES=2
UWSGI_WORKER_HARAKIRI=600
UWSGI_WORKER_RELOAD_ON_RSS=1024

# ----- Logging -----
LOG_LEVEL=INFO
JSON_LOG=0

# ----- Cookies (set to 1 only if HTTPS) -----
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
CSRF_COOKIE_HTTPONLY=1

# ----- Storage policy -----
# LINK_ONLY_IMPORT=1  → local file upload disabled
# Files must come as URLs (Cloudinary, S3, GCS, any public HTTP URL)
# Raw bytes are NEVER stored on the VPS
LINK_ONLY_IMPORT=1

# ----- Cloudinary (used for file uploads → stored as links) -----
# Files uploaded through Label Studio go to Cloudinary.
# VPS only stores the returned URL — no raw file on disk.
CLOUDINARY_CLOUD_NAME=dk9v5b3zj
CLOUDINARY_UPLOAD_PRESET=fixstudio
CLOUDINARY_FOLDER=label-studio

# ----- Export hardening -----
# Do NOT re-download cloud media during export
CONVERTER_DOWNLOAD_RESOURCES=0
# Async snapshot jobs timeout (seconds)
RQ_LONG_JOB_TIMEOUT=10800

# ----- Telemetry off -----
SENTRY_DSN=
SENTRY_RATE=0
FRONTEND_SENTRY_DSN=
FRONTEND_SENTRY_RATE=0
COLLECT_ANALYTICS=0

# ----- CSP -----
ENABLE_CSP=0
LS_CSP_REPORT_ONLY=0

# ----- Nginx -----
NGINX_CLIENT_MAX_BODY_SIZE=512M
NGINX_PROXY_READ_TIMEOUT=600s
NGINX_PROXY_SEND_TIMEOUT=600s
NGINX_PROXY_CONNECT_TIMEOUT=120s
